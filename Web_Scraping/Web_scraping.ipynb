   "source": [
    "import json\n",
    "import re\n",
    "import time\n",
    "import unicodedata\n",
    "from collections import Counter\n",
    "from pathlib import Path\n",
    "from urllib.parse import urljoin, urlparse, parse_qs, unquote\n",
    "\n",
    "import requests\n",
    "from bs4 import BeautifulSoup\n",
    "\n",
    "\n",
    "# ── Host e parâmetros de busca ────────────────────────────────────────────\n",
    "URL = \"https://bdex.eb.mil.br\"\n",
    "RPP = 100                      # resultados por página (máximo aceito pelo DSpace)\n",
    "PAUSA = 1.0                    # segundos entre requisições\n",
    "\n",
    "PARAMS_MANUAL = {              # formato para APLICAR um filtro novo\n",
    "    \"filterquery\": \"Manual de Campanha\",\n",
    "    \"filtername\": \"typeArchive\",\n",
    "    \"filtertype\": \"equals\",\n",
    "}\n",
    "\n",
    "PARAMS_BUSCA = {               # formato do filtro JÁ ATIVO (usado na paginação)\n",
    "    \"query\": \"\",\n",
    "    \"filter_field_1\": \"typeArchive\",\n",
    "    \"filter_type_1\": \"equals\",\n",
    "    \"filter_value_1\": \"Manual de Campanha\",\n",
    "    \"sort_by\": \"score\",\n",
    "    \"order\": \"desc\",\n",
    "    \"rpp\": RPP,\n",
    "    \"etal\": 0,\n",
    "}\n",
    "\n",
    "\n",
    "# ── Caminhos ancorados na raiz do projeto ─────────────────────────────────\n",
    "def achar_raiz(marcador=\".git\"):\n",
    "    \"\"\"Sobe na árvore de diretórios até encontrar a pasta que contém o marcador.\"\"\"\n",
    "    atual = Path.cwd().resolve()\n",
    "    for pasta in [atual, *atual.parents]:\n",
    "        if (pasta / marcador).exists():\n",
    "            return pasta\n",
    "    # Sem repositório Git: assume que o notebook está um nível abaixo da raiz\n",
    "    return atual.parent\n",
    "\n",
    "\n",
    "RAIZ = achar_raiz()\n",
    "PASTA_PDF = RAIZ / \"Arquivos\"\n",
    "PASTA_REVOGADOS = PASTA_PDF / \"Revogados\"\n",
    "PASTA_COLETA = RAIZ / \"web_scraping\" / \"Coleta\"\n",
    "ARQUIVO_JSON = PASTA_COLETA / \"manuais_campanha.json\"\n",
    "\n",
    "for pasta in (PASTA_PDF, PASTA_REVOGADOS, PASTA_COLETA):\n",
    "    pasta.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "print(f\"raiz      : {RAIZ}\")\n",
    "print(f\"vigentes  : {PASTA_PDF}\")\n",
    "print(f\"revogados : {PASTA_REVOGADOS}\")\n",
    "print(f\"catálogo  : {ARQUIVO_JSON}\")"
   ]
