    "                print(f\"    {d['handle']}  {d['data']}  {d['titulo'][:45]}\")\n",
    "\n",
    "# Marca revogados e deduplica\n",
    "vistos = set()\n",
    "selecao = []\n",
    "\n",
    "for d in manuais:\n",
    "    if not d.get(\"url_pdf\"):\n",
    "        continue\n",
    "    if ano_de(d) < ANO_MINIMO:\n",
    "        continue\n",
    "    if d[\"nome_arquivo\"] in vistos:\n",
    "        d[\"duplicata\"] = True\n",
