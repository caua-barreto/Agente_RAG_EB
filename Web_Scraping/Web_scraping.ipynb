   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Funções de coleta\n",
    "\n",
    "As quatro funções que conversam com o servidor.\n",
    "\n",
    "- **`ler_facet_tipos()`** — lê uma página do facet *Tipo de Documento*\n",
    "- **`contar_total()`** — extrai o total de resultados do texto `Resultado 1-10 de 273.`\n",
    "- **`extrair_resultados()`** — converte uma página de resultados em lista de dicionários\n",
    "- **`achar_pdf()`** — visita a página de um item e devolve a URL do PDF\n",
    "- **`baixar()`** — baixa um PDF com cache, verificação de tipo e arquivo temporário\n",
    "\n",
    "### Decisões que valem registrar\n",
    "\n",
    "**O valor do filtro vem do `href`, não do texto visível.** No facet, nomes longos\n",
    "aparecem truncados com reticências (`Escola de Aperfei...`); montar um filtro com isso\n",
    "não encontraria nada, e a falha seria silenciosa. O `href` sempre traz o valor íntegro,\n",
    "e o `parse_qs` já o decodifica.\n",
    "\n",
    "**As células da tabela são identificadas por `headers`, não por posição.** O DSpace\n",
    "marca cada `<td>` com `headers=\"t1\"`, `t2`, `t3` apontando para o cabeçalho da coluna.\n",
    "Usar isso em vez de `tds[1]` faz o código sobreviver a uma reordenação de colunas — e\n",
    "descarta a linha de cabeçalho naturalmente, já que ela só tem `<th>`.\n",
    "\n",
    "**`urljoin` em vez de concatenar strings.** Alguns itens trazem o href do bitstream como\n",
    "URL absoluta em vez de relativa. Concatenar `URL + href` nesses casos produz\n",
    "`bdex.eb.mil.brhttps://...` e a requisição falha. O `urljoin` resolve os dois casos:\n",
    "junta quando é relativo, devolve como está quando já é absoluto.\n",
    "\n",
    "**O `return` dentro do laço deduplica.** O mesmo link do PDF aparece três vezes na\n",
    "página do item (com o nome, com um ícone, e como \"Visualizar/Abrir\"). Retornar no\n",
    "primeiro acerto resolve sem precisar de `set`.\n",
    "\n",
    "**Arquivo temporário no download.** Se a conexão cair no meio, resta um `.parcial`\n",
    "truncado — e não um `.pdf` incompleto que o cache da próxima execução consideraria\n",
    "pronto. O nome final só aparece quando o download termina.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Funções de coleta carregadas.\n"
     ]
    }
   ],
   "source": [
    "def ler_facet_tipos(pagina=0):\n",
    "    \"\"\"Lê uma página do facet 'Tipo de Documento'.\n",
    "\n",
    "    Devolve lista de (exibido, valor, contagem). Lista vazia se não houver facet.\n",
    "    \"\"\"\n",
    "    r = sessao.get(f\"{URL}/jspui/simple-search\",\n",
    "                   params={\"query\": \"\", \"typeArchive_page\": pagina},\n",
    "                   timeout=60)\n",
    "    r.raise_for_status()\n",
    "    r.encoding = \"utf-8\"\n",
    "\n",
    "    bloco = BeautifulSoup(r.text, \"html.parser\").find(\"div\", id=\"facet_typeArchive\")\n",
    "    if bloco is None:\n",
    "        return []\n",
    "\n",
    "    resultado = []\n",
    "    for li in bloco.find_all(\"li\", class_=\"list-group-item\"):\n",
    "        link = li.find(\"a\")\n",
    "        badge = li.find(\"span\", class_=\"badge\")\n",
    "\n",
    "        # A linha do \"próximo >\" tem link mas não tem badge\n",
    "        if link is None or badge is None:\n",
    "            continue\n",
    "\n",
    "        # O texto visível pode vir truncado; o valor íntegro está no href\n",
    "        params = parse_qs(urlparse(link[\"href\"]).query)\n",
    "        valor = params.get(\"filterquery\", [None])[0]\n",
    "        if valor is None:\n",
    "            continue\n",
    "\n",
    "        resultado.append((\n",
    "            link.get_text(strip=True),\n",
    "            valor,\n",
    "            int(badge.get_text(strip=True)),\n",
    "        ))\n",
    "\n",
    "    return resultado\n",
    "\n",
    "\n",
    "RE_TOTAL = re.compile(r\"^Resultado \\d+-\\d+ de (\\d+)\")\n",
    "\n",
    "\n",
    "def contar_total(soup):\n",
    "    \"\"\"Extrai o total de resultados do texto 'Resultado 1-10 de 273.'\"\"\"\n",
    "    for txt in soup.stripped_strings:\n",
    "        m = RE_TOTAL.match(txt)\n",
    "        if m:\n",
    "            return int(m.group(1))\n",
    "    return None\n",
    "\n",
    "\n",
    "def extrair_resultados(soup):\n",
    "    \"\"\"Extrai os documentos de uma página de resultados.\n",
    "\n",
    "    Devolve lista de dicts com data, titulo, autor e handle.\n",
    "    \"\"\"\n",
    "    tabela = soup.find(\"table\", class_=\"table\")\n",
    "    if tabela is None:\n",
    "        return []\n",
    "\n",
    "    docs = []\n",
    "    for tr in tabela.find_all(\"tr\"):\n",
    "        # A linha de cabeçalho só tem <th>, então não passa daqui\n",
    "        td_titulo = tr.find(\"td\", attrs={\"headers\": \"t2\"})\n",
    "        if td_titulo is None:\n",
    "            continue\n",
    "\n",
    "        link = td_titulo.find(\"a\")\n",
    "        if link is None:\n",
    "            continue\n",
    "\n",
    "        td_data = tr.find(\"td\", attrs={\"headers\": \"t1\"})\n",
    "        td_autor = tr.find(\"td\", attrs={\"headers\": \"t3\"})\n",
    "\n",
    "        docs.append({\n",
    "            \"data\": td_data.get_text(strip=True) if td_data else None,\n",
    "            \"titulo\": link.get_text(strip=True),\n",
    "            \"autor\": td_autor.get_text(strip=True) if td_autor else None,\n",
    "            \"handle\": link[\"href\"],\n",
    "        })\n",
    "\n",
    "    return docs\n",
    "\n",
    "\n",
    "def achar_pdf(handle):\n",
    "    \"\"\"Dado o handle de um item, devolve (url_pdf, nome_arquivo) ou (None, None).\"\"\"\n",
    "    url_item = urljoin(URL, handle)\n",
    "    r = sessao.get(url_item, timeout=60)\n",
    "    r.raise_for_status()\n",
    "    r.encoding = \"utf-8\"\n",
    "\n",
    "    soup = BeautifulSoup(r.text, \"html.parser\")\n",
    "\n",
    "    for a in soup.find_all(\"a\", href=True):\n",
    "        href = a[\"href\"]\n",
    "        if \"/bitstream/\" in href and href.lower().endswith(\".pdf\"):\n",
    "            # urljoin cobre href relativo E absoluto\n",
    "            url_pdf = urljoin(url_item, href)\n",
    "            nome = nome_seguro(href.rsplit(\"/\", 1)[-1])\n",
    "            return url_pdf, nome\n",
    "\n",
    "    return None, None\n",
    "\n",
    "\n",
    "def baixar(url_pdf, nome_arquivo, pasta_destino):\n",
    "    \"\"\"Baixa um PDF. Devolve (caminho, status); caminho None indica falha.\"\"\"\n",
    "    destino = pasta_destino / nome_arquivo\n",
    "\n",
    "    if destino.exists() and destino.stat().st_size > 0:\n",
    "        return destino, \"já existe\"\n",
    "\n",
    "    with sessao.get(url_pdf, timeout=300, stream=True) as resp:\n",
    "        resp.raise_for_status()\n",
    "\n",
    "        # Uma página de erro HTML com status 200 seria salva como .pdf corrompido\n",
    "        tipo = resp.headers.get(\"content-type\", \"\")\n",
    "        if \"pdf\" not in tipo.lower():\n",
    "            return None, f\"não é PDF ({tipo})\"\n",
    "\n",
    "        # Grava num temporário: conexão interrompida não deixa .pdf truncado\n",
    "        temp = destino.with_name(destino.name + \".parcial\")\n",
    "        with open(temp, \"wb\") as f:\n",
    "            for pedaco in resp.iter_content(chunk_size=65536):\n",
    "                f.write(pedaco)\n",
    "        temp.replace(destino)\n",
    "\n",
    "    return destino, f\"{destino.stat().st_size / 1024 / 1024:.1f} MB\"\n",
    "\n",
    "\n",
    "print(\"Funções de coleta carregadas.\")"
   ]
  },
